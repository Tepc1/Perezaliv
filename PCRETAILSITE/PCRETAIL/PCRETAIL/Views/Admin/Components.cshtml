@model PCRETAIL.Models.AdminComponentsViewModel
@{
    ViewData["Title"] = "Комплектующие";
    var componentTypes = (ViewBag.ComponentTypes as IEnumerable<string>) ?? Enumerable.Empty<string>();
    var componentImageOptions = (ViewBag.ComponentImageOptions as IEnumerable<string>) ?? Enumerable.Empty<string>();
    var componentImageUrls = (ViewBag.ComponentImageUrls as IDictionary<int, string>) ?? new Dictionary<int, string>();
}

<h1>Комплектующие</h1>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title mb-3">Добавить комплектующее</h4>

                <form asp-action="Components" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Type" class="form-label"></label>
                        <select asp-for="Type" class="form-select">
                            <option value="">Выберите тип</option>
                            @foreach (var type in componentTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Price" class="form-label"></label>
                        <input asp-for="Price" class="form-control" type="number" min="0" step="0.01" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ImagePath" class="form-label">Изображение</label>
                        <select asp-for="ImagePath" class="form-select">
                            <option value="">(без изображения)</option>
                            @foreach (var image in componentImageOptions)
                            {
                                <option value="@image">@image</option>
                            }
                        </select>
                        <div class="form-text">Показываются только файлы из папки Pictures\PCRETAILIMAGES\COMPONENTS.</div>
                        <span asp-validation-for="ImagePath" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-success w-100">Создать</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="card-title mb-0">Список комплектующих</h4>
                    <span class="badge text-bg-secondary">@Model.Components.Count</span>
                </div>

                @if (!Model.Components.Any())
                {
                    <div class="alert alert-info mb-0">Комплектующих пока нет.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>Изображение</th>
                                    <th>ID</th>
                                    <th>Название</th>
                                    <th>Тип</th>
                                    <th>Цена</th>
                                    <th>ImagePath</th>
                                    <th>Создан</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var component in Model.Components)
                                {
                                    componentImageUrls.TryGetValue(component.Id, out var imageUrl);
                                    <tr>
                                        <td style="width: 90px;">
                                            @if (!string.IsNullOrWhiteSpace(imageUrl))
                                            {
                                                <img src="@imageUrl" alt="@component.Name" class="img-thumbnail" style="max-height: 64px;" />
                                            }
                                        </td>
                                        <td>@component.Id</td>
                                        <td>@component.Name</td>
                                        <td>@component.Type</td>
                                        <td>@component.Price.ToString("C")</td>
                                        <td>@component.ImagePath</td>
                                        <td>@component.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>
                                            <a asp-action="EditComponent" asp-route-id="@component.Id" class="btn btn-sm btn-outline-primary">Редактировать</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">Назад</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model PCRETAIL.Models.PcConfiguration
@{
    ViewData["Title"] = "Сборка: " + Model.Name;
    decimal totalPrice = ViewBag.TotalPrice ?? 0;
    var configurationImageUrl = ViewBag.ConfigurationImageUrl as string;
    var componentImages = (ViewBag.ComponentImages as IDictionary<int, string>) ?? new Dictionary<int, string>();
}

<h1>@Model.Name</h1>

<div class="card mb-4">
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(configurationImageUrl))
        {
            <div class="mb-3 text-center">
                <img src="@configurationImageUrl" alt="Изображение сборки" class="img-fluid" style="max-height: 300px;" />
            </div>
        }
        <dl class="row">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Категория</dt>
            <dd class="col-sm-9">@Model.Category</dd>

            <dt class="col-sm-3">Статус</dt>
            <dd class="col-sm-9">
                <span class="badge bg-@(Model.Status switch {
                    "Pending" => "warning",
                    "InProgress" => "primary",
                    "Completed" => "success",
                    _ => "secondary"
                })">
                    @(Model.Status switch
                    {
                        "Pending" => "Ожидание",
                        "InProgress" => "В работе",
                        "Completed" => "Выполнено",
                        _ => Model.Status
                    })
                </span>
            </dd>

            <dt class="col-sm-3">Дата создания</dt>
            <dd class="col-sm-9">@Model.CreatedDate.ToShortDateString()</dd>

            <dt class="col-sm-3">Владелец</dt>
            <dd class="col-sm-9">@Model.User?.Email</dd>
        </dl>
    </div>
</div>

<h4>Комплектующие</h4>
@if (Model.Components != null && Model.Components.Any())
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Изображение</th>
                <th>Тип</th>
                <th>Название</th>
                <th class="text-end">Цена</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var comp in Model.Components.OrderBy(c => c.Type))
            {
                componentImages.TryGetValue(comp.Id, out var componentImageUrl);
                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(componentImageUrl))
                        {
                            <img src="@componentImageUrl" alt="@comp.Name" class="img-thumbnail" style="max-height: 80px;" />
                        }
                    </td>
                    <td>@comp.Type</td>
                    <td>@comp.Name</td>
                    <td class="text-end">@comp.Price.ToString("C")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="fw-bold">
                <td colspan="3" class="text-end">Итого:</td>
                <td class="text-end">@totalPrice.ToString("C")</td>
            </tr>
        </tfoot>
    </table>
}
else
{
    <p class="text-muted">В сборке нет компонентов.</p>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
</div>
